{
  "name": "smartpi-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --minify --outfile=../custom_components/smartpi_dashboard/frontend/smartpi-dashboard.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/adapter.ts --bundle --platform=node --format=esm --target=node22 --outfile=.build-tests/adapter.mjs && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lit": "3.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "5.9.2"
  }
}
